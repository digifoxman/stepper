---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --page-bg: #fbfbfd;
    --page-text: #172033;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --page-bg: #121722;
      --page-text: #e6e9f0;
    }
  }
  body {
    margin: 0;
    background: var(--page-bg);
    color: var(--page-text);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2.5rem 1rem 4rem;
  }
  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }
  .intro {
    margin: 0 0 1.5rem;
    opacity: 0.75;
  }
</style>
