{
  "folders": [{ "path": "." }],
  "settings": {
    // Autocomplete and error checking while you edit the stepper's JSON files.
    // Name them <name>-diagram.json and <name>-steps.json for this to apply.
    "json.schemas": [
      {
        "fileMatch": ["/src/data/*-diagram.json"],
        "url": "./schemas/diagram.schema.json"
      },
      {
        "fileMatch": ["/src/data/*-steps.json"],
        "url": "./schemas/steps.schema.json"
      }
    ],
    "files.exclude": {
      "**/.astro": true
    }
  },
  "extensions": {
    "recommendations": ["astro-build.astro-vscode"]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Development server",
        "command": "npm run dev",
        "request": "launch",
        "type": "node-terminal"
      }
    ]
  }
}
